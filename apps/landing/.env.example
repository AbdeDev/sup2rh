# Copie ce fichier en .env et adapte les valeurs si besoin.
# L'API doit être démarrée (bun run dev:api) pour que les fiches métiers s'affichent.

# URL de l'API backend (défaut: http://127.0.0.1:8000)
PUBLIC_API_URL=http://127.0.0.1:8000

# URL de l'app web (pour les liens Se connecter / fiches)
PUBLIC_WEB_URL=http://localhost:5173
