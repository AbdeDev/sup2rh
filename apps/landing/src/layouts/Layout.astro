<!doctype html>
<html lang="fr" class="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/supdesrh-logo.png" />
		<meta name="generator" content={Astro.generator} />
		<title>RH et moi by SUP des RH · Découvre ton métier RH</title>
		<meta
			name="description"
			content="Découvre le métier RH qui te correspond : Recrutement, Paie, QVCT, Assistant RH, Formation."
		/>
	</head>
	<body>
		<slot />
		<script>
			(function () {
				const KEY = "supdesrh-theme";
				const root = document.documentElement;

				function applyTheme(theme) {
					root.classList.remove("light", "dark");
					root.classList.add(theme);
					try {
						localStorage.setItem(KEY, theme);
					} catch (e) {}
				}

				let theme = "light";
				try {
					const stored = localStorage.getItem(KEY);
					if (stored === "light" || stored === "dark") {
						theme = stored;
					} else if (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) {
						theme = "dark";
					}
				} catch (e) {}

				applyTheme(theme);

				window.supdesrhToggleTheme = function () {
					theme = theme === "dark" ? "light" : "dark";
					applyTheme(theme);
				};

				// Mobile nav (présent sur Accueil / École / Entreprises)
				window.addEventListener("DOMContentLoaded", () => {
					const mobileToggle = document.getElementById("mobile-menu-toggle");
					const mobileNav = document.getElementById("mobile-nav");
					if (mobileToggle && mobileNav) {
						mobileToggle.addEventListener("click", () => {
							mobileNav.classList.toggle("open");
						});
						mobileNav.querySelectorAll("a").forEach((link) => {
							link.addEventListener("click", () => {
								mobileNav.classList.remove("open");
							});
						});
					}
				});
			})();
		</script>
	</body>
</html>

