		/>
		<!-- Umami Analytics (auto-hébergé, RGPD-friendly, pas de cookies) -->
		<script defer src="https://analytics.rhetmoi.fr/script.js" data-website-id="UMAMI_WEBSITE_ID"></script><script defer src="https://cloud.umami.is/script.js" data-website-id="e2a9fdb5-1d4d-4882-bbc5-4fc80ab7450a"></script>
	</head>
	<body>
		<slot />
		<!-- Scroll-reveal observer -->
		<script is:inline>
			(function(){
				var obs = new IntersectionObserver(function(entries){
					entries.forEach(function(e){
						if(e.isIntersecting){
							e.target.classList.add("revealed");
							obs.unobserve(e.target);
						}
					});
				},{threshold:0.12, rootMargin:"0px 0px -40px 0px"});
				function initReveal(){
					document.querySelectorAll(".reveal").forEach(function(el){ obs.observe(el); });
				}
				if(document.readyState==="loading") document.addEventListener("DOMContentLoaded",initReveal);
				else initReveal();
			})();
		</script>
		<script is:inline>
			(function () {
				const KEY = "supdesrh-theme";
				const root = document.documentElement;

				function applyTheme(theme) {
					root.classList.remove("light", "dark");
					root.classList.add(theme);
					try {
						localStorage.setItem(KEY, theme);
					} catch (e) {}
				}

				let theme = "light";
				try {
					const stored = localStorage.getItem(KEY);
					if (stored === "light" || stored === "dark") {
						theme = stored;
					} else if (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) {
						theme = "dark";
					}
				} catch (e) {}

				applyTheme(theme);

				window.supdesrhToggleTheme = function () {
					theme = theme === "dark" ? "light" : "dark";
					applyTheme(theme);
				};

			window.supdesrhToggleLang = function () {
				const LANG_KEY = "rhmoi_lang";
				try {
					const current = localStorage.getItem(LANG_KEY) || "fr";
					const next = current === "fr" ? "en" : "fr";
					localStorage.setItem(LANG_KEY, next);
					window.location.reload();
				} catch (e) {}
			};

			window.supdesrhApplyI18n = function (dict) {
				if (!dict) return;
				function resolve(obj, path) {
					return path.split(".").reduce(function (o, k) { return o && o[k]; }, obj);
				}
				document.querySelectorAll("[data-i18n]").forEach(function (el) {
					var key = el.getAttribute("data-i18n");
					var val = resolve(dict, key);
					if (val != null) {
						if (el.hasAttribute("data-i18n-html")) {
							el.innerHTML = val;
						} else {
							el.textContent = val;
						}
					}
				});
				document.querySelectorAll("[data-i18n-placeholder]").forEach(function (el) {
					var key = el.getAttribute("data-i18n-placeholder");
					var val = resolve(dict, key);
					if (val != null) el.placeholder = val;
				});
			};

			// Mobile nav (présent sur Accueil / École / Entreprises)
			window.addEventListener("DOMContentLoaded", () => {
					const mobileToggle = document.getElementById("mobile-menu-toggle");
					const mobileNav = document.getElementById("mobile-nav");
					if (mobileToggle && mobileNav) {
						mobileToggle.addEventListener("click", () => {
							mobileNav.classList.toggle("open");
						});
						mobileNav.querySelectorAll("a").forEach((link) => {
							link.addEventListener("click", () => {
								mobileNav.classList.remove("open");
							});
						});
					}
				});
			})();
		</script>
	</body>
</html>

