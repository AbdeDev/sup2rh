---
import Layout from "../layouts/Layout.astro";

const WEB_APP_URL = import.meta.env.PUBLIC_WEB_URL || "http://localhost:5173";
const API_BASE_URL = (import.meta.env.PUBLIC_API_URL || "http://127.0.0.1:8000") + "/api";

const services = [
  {
    icon: "📋",
    title: "Déposer une offre d'alternance ou de stage",
    desc: "Publiez votre offre directement auprès de nos étudiants en formation. Nous vous mettons en relation avec les profils correspondant exactement à vos besoins.",
    cta: "Déposer une offre",
    href: "https://www.supdesrh.com/espace-entreprises/deposer-une-offre-dalternance-stage/",
    color: "#004080",
  },
  {
    icon: "🤝",
    title: "Recruter un Alumni",
    desc: "Accédez à notre réseau de +8 500 diplômés actifs dans toute la France. Des profils RH opérationnels, déjà formés à nos méthodes et prêts à rejoindre vos équipes.",
    cta: "Voir les alumni",
    href: "https://www.supdesrh.com/espace-entreprises/recruter-un-alumni/",
    color: "#008c54",
  },
  {
    icon: "🎤",
    title: "Intervenir en tant qu'expert RH",
    desc: "Partagez votre expertise auprès de nos apprenants. Contribuez à former la prochaine génération de professionnels RH en tant qu'intervenant ou jury.",
    cta: "Devenir intervenant",
    href: "https://www.supdesrh.com/espace-entreprises/intervenir-a-sup-des-rh/",
    color: "#f37021",
  },
  {
    icon: "🌐",
    title: "Devenir partenaire de SUP des RH",
    desc: "Renforcez votre marque employeur en rejoignant notre réseau de partenaires. Accès au vivier de talents, participation aux événements, communication sur vos valeurs.",
    cta: "Devenir partenaire",
    href: "https://www.supdesrh.com/espace-entreprises/devenir-un-partenaire-de-sup-des-rh/",
    color: "#6b21a8",
  },
];

const avantages = [
  { icon: "🎓", title: "Titres RNCP reconnus par l'État", desc: "Bac+3 (Niveau 6), Bac+5 et Bac+6 (Niveau 7) — diplômes valables en France et en Europe.", color: "#004080" },
  { icon: "💰", title: "Alternance financée — 0 coût", desc: "La rémunération de l'alternant est prise en charge par votre OPCO. Nos équipes vous accompagnent dans toutes les démarches.", color: "#008c54" },
  { icon: "🔄", title: "Rythme adapté à vos besoins", desc: "Nos rythmes d'alternance sont optimisés pour s'intégrer à votre organisation et maximiser la montée en compétences.", color: "#f37021" },
  { icon: "📊", title: "Suivi pédagogique continu (C.A.R.E)", desc: "Un tuteur pédagogique dédié suit chaque apprenant. Vous êtes accompagné et informé à chaque étape du parcours.", color: "#6b21a8" },
  { icon: "🏆", title: "Évalué par des professionnels RH", desc: "Nos programmes intègrent DRH et RRH partenaires dans la formation et l'évaluation. Des profils directement opérationnels.", color: "#0891b2" },
  { icon: "🌍", title: "Réseau national & international", desc: "SUP des RH est présent à Paris et en régions. Certains parcours incluent un programme Erasmus ou une mobilité internationale.", color: "#e11d48" },
];

const etapes = [
  { step: "01", title: "Déposez votre demande", desc: "Remplissez le formulaire ci-dessous ou appelez-nous. Notre équipe répond sous 48h ouvrées.", icon: "📝" },
  { step: "02", title: "Entretien de cadrage", desc: "Un conseiller SUP des RH vous contacte pour comprendre vos besoins, le profil recherché et les modalités.", icon: "💬" },
  { step: "03", title: "Présélection des candidats", desc: "Nous présélectionnons les apprenants correspondant à votre besoin et vous soumettrons leur dossier.", icon: "🔍" },
  { step: "04", title: "Intégration de l'alternant", desc: "Votre alternant intègre votre équipe. SUP des RH assure le suivi pédagogique tout au long du contrat.", icon: "🚀" },
];

const temoignages = [
  {
    initiales: "YE",
    nom: "Youmna El Boubou",
    poste: "Directrice des Ressources Humaines",
    entreprise: "Fondation Mérieux",
    texte: "SUP des RH forme des profils vraiment opérationnels. Nos alternants arrivent avec des bases solides et une vraie compréhension des enjeux RH terrain.",
    color: "#004080",
  },
  {
    initiales: "FP",
    nom: "Florence Prunet",
    poste: "HRBP",
    entreprise: "Guerlain",
    texte: "La qualité de l'enseignement et l'approche pratique font la différence. Nos alternants SUP des RH s'intègrent rapidement et apportent une vraie valeur ajoutée.",
    color: "#008c54",
  },
];

const stats = [
  { value: "600+", label: "Entreprises partenaires", icon: "🏢" },
  { value: "100%", label: "Placement en alternance", icon: "✅" },
  { value: "+8 500", label: "Alumnis actifs", icon: "🎓" },
  { value: "27 ans", label: "D'expérience (depuis 1998)", icon: "📅" },
];

const formations = [
  { title: "Chargé des RH", level: "Bac+3", rncp: "Niveau 6", access: "Post Bac+2", color: "#004080" },
  { title: "Manager des RH — Filière RH", level: "Bac+5", rncp: "Niveau 7", access: "Post Bac+3/4", color: "#008c54" },
  { title: "Manager des RH — Toutes filières", level: "Bac+5", rncp: "Niveau 7", access: "Post Bac+3/4", color: "#f37021" },
  { title: "Manager des RH — International", level: "Bac+5", rncp: "Niveau 7 · Erasmus+", access: "Post Bac+3", color: "#6b21a8" },
  { title: "Resp. Rémunération & Avantages Sociaux", level: "Bac+6", rncp: "Niveau 7 — Executive MBA", access: "Post Bac+5", color: "#0891b2" },
];
---

<Layout>
  <div class="page">
    <header class="site-header">
        <div class="logo-wrap">
          <img src="/supdesrh-logo.png" alt="RH&MOI by SUP des RH" class="logo-img logo-theme-safe" width="56" height="56" />
          <div class="brand-text">
            <p class="brand">RH&MOI <span class="brand-by">by</span> SUP des RH</p>
            <p class="brand-sub">Orientation métiers RH</p>
          </div>
        </div>
      <nav class="header-nav">
        <a href="/" class="nav-link">Accueil</a>
        <a href="/ecole" class="nav-link">L'école</a>
        <a href="/entreprises" class="nav-link nav-link-active">Entreprises</a>
      </nav>
      <div class="header-actions">
        <button type="button" class="btn-theme" id="theme-toggle" aria-label="Changer le thème">
          <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <a href={WEB_APP_URL + "/login"} class="btn-connect">Se connecter</a>
        <button type="button" class="btn-menu" id="mobile-menu-toggle" aria-label="Ouvrir le menu">
          <span class="menu-line"></span>
          <span class="menu-line"></span>
        </button>
      </div>
      <nav class="mobile-nav" id="mobile-nav">
        <a href="/" class="mobile-nav-link">Accueil</a>
        <a href="/ecole" class="mobile-nav-link">L'école</a>
        <a href="/entreprises" class="mobile-nav-link">Entreprises</a>
      </nav>
    </header>

    <main class="main">

      <!-- ── Hero ── -->
      <section class="ent-hero">
        <span class="hero-badge">Espace entreprises</span>
        <h1 class="hero-title">
          Recrutez les talents RH <span class="highlight">de demain</span>
        </h1>
        <p class="hero-sub">
          SUP des RH est l'école de référence 100% RH depuis 1998. Plus de 600 entreprises partenaires nous font confiance pour former leurs futurs alternants, recruter leurs talents et développer leurs équipes RH.
        </p>
        <div class="hero-actions">
          <a href="#contact" class="btn-primary">Déposer ma demande →</a>
          <a href="https://www.supdesrh.com/espace-entreprises/" target="_blank" rel="noopener noreferrer" class="btn-secondary">
            Portail entreprises ↗
          </a>
        </div>

        <!-- Stats bande -->
        <div class="hero-stats-band">
          {stats.map((s) => (
            <div class="hstat">
              <span class="hstat-icon">{s.icon}</span>
              <p class="hstat-val">{s.value}</p>
              <p class="hstat-lbl">{s.label}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- ── Services ── -->
      <section class="section-services">
        <div class="section-header">
          <div class="section-badge">Nos services</div>
          <h2 class="section-title">Comment pouvons-nous vous aider ?</h2>
          <p class="section-desc">SUP des RH met à votre disposition plusieurs dispositifs pour trouver et développer les profils RH dont vous avez besoin.</p>
        </div>
        <div class="services-grid">
          {services.map((s) => (
            <article class="service-card" style={`--sc: ${s.color};`}>
              <div class="service-top-bar" style={`background: ${s.color};`}></div>
              <span class="service-icon">{s.icon}</span>
              <h3 class="service-title">{s.title}</h3>
              <p class="service-desc">{s.desc}</p>
              <a href={s.href} target="_blank" rel="noopener noreferrer" class="service-link" style={`color: ${s.color};`}>
                {s.cta} →
              </a>
            </article>
          ))}
        </div>
      </section>

      <!-- ── Processus ── -->
      <section class="section-process">
        <div class="section-header">
          <div class="section-badge section-badge-green">Comment ça marche</div>
          <h2 class="section-title">Recruter un alternant en 4 étapes</h2>
          <p class="section-desc">Un processus simple et rapide, accompagné par notre équipe du premier contact à l'intégration.</p>
        </div>
        <div class="process-timeline">
          {etapes.map((e, idx) => (
            <div class="process-step">
              <div class="step-connector">
                <div class="step-dot">
                  <span class="step-num">{e.step}</span>
                </div>
                {idx < etapes.length - 1 && <div class="step-line"></div>}
              </div>
              <div class="step-content">
                <span class="step-icon">{e.icon}</span>
                <h3 class="step-title">{e.title}</h3>
                <p class="step-desc">{e.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ── Avantages ── -->
      <section class="section-avantages">
        <div class="section-header">
          <div class="section-badge section-badge-orange">Pourquoi nous choisir</div>
          <h2 class="section-title">Pourquoi recruter chez SUP des RH ?</h2>
          <p class="section-desc">Des apprenants rigoureusement sélectionnés, formés par des praticiens RH, accompagnés tout au long de leur parcours.</p>
        </div>
        <div class="avantages-grid">
          {avantages.map((a) => (
            <div class="avantage-item">
              <div class="avantage-icon-wrap" style={`background: ${a.color}14; border: 1px solid ${a.color}22;`}>
                <span class="avantage-icon">{a.icon}</span>
              </div>
              <div class="avantage-content">
                <p class="avantage-title">{a.title}</p>
                <p class="avantage-desc">{a.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ── Profils disponibles ── -->
      <section class="section-formations">
        <div class="section-header">
          <div class="section-badge">Profils disponibles</div>
          <h2 class="section-title">Les formations de nos alternants</h2>
          <p class="section-desc">De Bac+3 à Bac+6, des profils formés aux réalités du terrain RH, tous en alternance et titulaires d'un diplôme reconnu par l'État.</p>
        </div>
        <div class="formations-strip">
          {formations.map((f) => (
            <div class="formation-chip" style={`border-color: ${f.color}28; background: ${f.color}08;`}>
              <span class="chip-level" style={`color: ${f.color}; background: ${f.color}14; border: 1px solid ${f.color}30;`}>{f.level}</span>
              <span class="chip-title">{f.title}</span>
              <span class="chip-rncp">{f.rncp}</span>
            </div>
          ))}
        </div>
        <div style="text-align:center; margin-top:1.5rem;">
          <a href="/ecole#formations" class="btn-secondary">Voir le détail des formations →</a>
        </div>
      </section>

      <!-- ── Témoignages ── -->
      <section class="section-temoignages">
        <div class="section-header">
          <div class="section-badge section-badge-purple">Ils nous font confiance</div>
          <h2 class="section-title">Ce que disent nos entreprises partenaires</h2>
        </div>
        <div class="temoignages-grid">
          {temoignages.map((t) => (
            <blockquote class="temoignage-card">
              <div class="quote-mark" style={`color: ${t.color}; opacity: 0.3;`}>"</div>
              <p class="temoignage-text">{t.texte}</p>
              <footer class="temoignage-footer">
                <div class="temoignage-avatar" style={`background: ${t.color}18; color: ${t.color}; border: 1.5px solid ${t.color}30;`}>
                  {t.initiales}
                </div>
                <div>
                  <p class="temoignage-nom">{t.nom}</p>
                  <p class="temoignage-poste">{t.poste} — <span class="temoignage-entreprise">{t.entreprise}</span></p>
                </div>
              </footer>
            </blockquote>
          ))}
        </div>
      </section>

    </main>

    <!-- ── Formulaire de contact — pleine largeur ── -->
    <section id="contact" class="section-contact-branded">
      <div class="contact-branded-inner">

        <!-- Panneau bleu : infos -->
        <div class="contact-blue-panel">
          <span class="cp-badge">Contact direct</span>
          <h2 class="cp-title">Déposez votre<br/>demande</h2>
          <p class="cp-sub">Notre équipe vous recontacte sous <strong>48h ouvrées</strong> avec les profils les plus adaptés à votre organisation.</p>

          <div class="cp-stats">
            <div class="cp-stat">
              <span class="cp-stat-val">600+</span>
              <span class="cp-stat-lbl">Entreprises partenaires</span>
            </div>
            <div class="cp-stat-sep"></div>
            <div class="cp-stat">
              <span class="cp-stat-val">100%</span>
              <span class="cp-stat-lbl">Placement en alternance</span>
            </div>
            <div class="cp-stat-sep"></div>
            <div class="cp-stat">
              <span class="cp-stat-val">27 ans</span>
              <span class="cp-stat-lbl">D'expérience RH</span>
            </div>
          </div>

          <div class="cp-coords">
            <div class="cp-coord">
              <span class="cp-coord-icon">📍</span>
              <div>
                <p class="cp-coord-label">Adresse</p>
                <p class="cp-coord-val">39 rue De Moscou, 75008 Paris</p>
              </div>
            </div>
            <div class="cp-coord">
              <span class="cp-coord-icon">📞</span>
              <div>
                <p class="cp-coord-label">Téléphone</p>
                <a href="tel:0144780808" class="cp-coord-link">01 44 78 08 08</a>
              </div>
            </div>
            <div class="cp-coord">
              <span class="cp-coord-icon">🌐</span>
              <div>
                <p class="cp-coord-label">Portail entreprises</p>
                <a href="https://www.supdesrh.com/espace-entreprises/" target="_blank" rel="noopener noreferrer" class="cp-coord-link">supdesrh.com ↗</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Formulaire -->
        <div class="contact-form-panel">
          <div class="contact-form-card">
            <p class="form-card-eyebrow">Votre demande</p>
            <h3 class="form-card-title">Partagez votre besoin</h3>
            <form class="contact-form" id="company-contact-form">
              <div class="form-row">
                <div class="form-group">
                  <label for="companyName">Entreprise *</label>
                  <input type="text" id="companyName" name="companyName" placeholder="Nom de l'entreprise" required />
                </div>
                <div class="form-group">
                  <label for="contactName">Votre nom *</label>
                  <input type="text" id="contactName" name="contactName" placeholder="Prénom Nom" required />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="email">Email professionnel *</label>
                  <input type="email" id="email" name="email" placeholder="vous@entreprise.com" required />
                </div>
                <div class="form-group">
                  <label for="phone">Téléphone</label>
                  <input type="tel" id="phone" name="phone" placeholder="01 44 78 08 08" />
                </div>
              </div>
              <div class="form-group">
                <label for="formationInterest">Formation souhaitée</label>
                <select id="formationInterest" name="formationInterest">
                  <option value="">Sélectionnez une formation</option>
                  <option value="Chargé des RH (Bac+3) — alternance post Bac+2">Chargé des RH — Bac+3 (post Bac+2)</option>
                  <option value="Manager des RH (Bac+5) — filière RH">Manager des RH — Bac+5, filière RH</option>
                  <option value="Manager des RH (Bac+5) — toutes filières">Manager des RH — Bac+5, toutes filières</option>
                  <option value="Manager des RH (Bac+5) — parcours international">Manager des RH — Bac+5, parcours international</option>
                  <option value="Resp. Rémunération & Avantages Sociaux (Bac+6)">Resp. Rémunération &amp; Avantages Sociaux — Bac+6</option>
                  <option value="Plusieurs formations">Plusieurs formations / Tous profils</option>
                  <option value="Je ne sais pas encore">Je ne sais pas encore</option>
                </select>
              </div>
              <div class="form-group">
                <label for="message">Votre besoin *</label>
                <textarea id="message" name="message" rows="4" placeholder="Décrivez le poste souhaité, le secteur d'activité, le profil recherché, la période souhaitée…" required></textarea>
              </div>
              <div id="contact-feedback" class="contact-feedback hidden"></div>
              <button type="submit" class="btn-submit" id="contact-submit">
                <span id="contact-submit-label">Envoyer ma demande →</span>
              </button>
            </form>
          </div>
        </div>

      </div>
    </section>

    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-top">
          <div class="footer-brand-wrap">
            <img src="/lamascott-hero.png" alt="" class="footer-logo logo-theme-safe" width="32" height="32" />
            <p class="footer-brand">RH&MOI by SUP des RH</p>
          </div>
          <p class="footer-tagline">Orientation métiers RH, en toute confiance.</p>
        </div>
        <nav class="footer-links">
          <a href="/">Accueil</a>
          <a href="/ecole">L'école</a>
          <a href={WEB_APP_URL + "/legal/conditions"}>Conditions d'utilisation</a>
          <a href={WEB_APP_URL + "/legal/confidentialite"}>Politique de confidentialité</a>
          <a href={WEB_APP_URL + "/login"}>Accéder au quiz</a>
        </nav>
        <p class="footer-copy">© {new Date().getFullYear()} RH&MOI by SUP des RH — Tous droits réservés</p>
      </div>
    </footer>
  </div>
</Layout>

<script define:vars={{ API_BASE_URL }}>
  const btn = document.getElementById("theme-toggle");
  if (btn) {
    btn.addEventListener("click", () => {
      if (typeof window.supdesrhToggleTheme === "function") window.supdesrhToggleTheme();
    });
  }

  const form = document.getElementById("company-contact-form");
  const feedback = document.getElementById("contact-feedback");
  const submitBtn = document.getElementById("contact-submit");
  const submitLabel = document.getElementById("contact-submit-label");

  if (form && feedback && submitBtn && submitLabel) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitLabel.textContent = "Envoi en cours…";
      feedback.className = "contact-feedback hidden";

      const fd = new FormData(form);
      const body = {
        companyName: fd.get("companyName"),
        contactName: fd.get("contactName"),
        email: fd.get("email"),
        phone: fd.get("phone") || null,
        formationInterest: fd.get("formationInterest") || null,
        message: fd.get("message"),
      };

      try {
        const res = await fetch(API_BASE_URL + "/company-contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        if (res.ok) {
          feedback.textContent = "✅ Votre demande a bien été envoyée ! Nous vous recontacterons sous 48h.";
          feedback.className = "contact-feedback success";
          form.reset();
        } else {
          const err = await res.json().catch(() => ({}));
          feedback.textContent = "❌ Erreur : " + (err.message || "Veuillez réessayer.");
          feedback.className = "contact-feedback error";
        }
      } catch {
        feedback.textContent = "❌ Impossible d'envoyer. Vérifiez votre connexion et réessayez.";
        feedback.className = "contact-feedback error";
      }

      submitBtn.disabled = false;
      submitLabel.textContent = "Envoyer ma demande →";
    });
  }
</script>

<style>
  .page { min-height: 100vh; display: flex; flex-direction: column; }

  /* ── Header ── */
  .site-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 0.9rem 1.5rem;
    background: var(--landing-card); border-bottom: 1px solid var(--landing-border);
    backdrop-filter: blur(16px); position: sticky; top: 0; z-index: 50;
    transition: background 0.3s, border-color 0.3s;
  }
  .logo-wrap { display: flex; align-items: center; gap: 0.75rem; }
  .logo-img { width: 48px; height: 48px; object-fit: contain; }
  .logo-theme-safe { filter: none !important; opacity: 1 !important; }
  html.dark .logo-theme-safe { filter: none !important; }
  .brand { margin: 0; font-size: 1.1rem; font-weight: 700; color: var(--landing-accent); line-height: 1.2; font-family: "Figtree","Montserrat",system-ui,sans-serif; }
  .brand-by { font-weight: 500; color: var(--landing-muted); }
  .brand-sub { margin: 0; font-size: 0.7rem; color: var(--landing-muted); }
  .header-nav { display: flex; align-items: center; gap: 0.25rem; margin: 0 auto; }
  .nav-link { padding: 0.4rem 0.85rem; border-radius: 999px; font-size: 0.82rem; font-weight: 500; color: var(--landing-muted); text-decoration: none; transition: color 0.15s, background 0.15s; }
  .nav-link:hover, .nav-link-active { color: var(--landing-accent); background: rgba(0,64,128,0.08); }
  html.dark .nav-link:hover, html.dark .nav-link-active { background: rgba(56,189,248,0.1); }
  .header-actions { display: flex; align-items: center; gap: 0.75rem; }
  .btn-theme { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--landing-border); background: var(--landing-bg-soft); cursor: pointer; display: flex; align-items: center; justify-content: center; transition: transform 0.2s; }
  .btn-theme:hover { background: var(--landing-border); transform: scale(1.05); }
  .icon-moon { display: none; }
