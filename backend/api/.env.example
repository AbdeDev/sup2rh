###> symfony/framework-bundle ###
APP_SECRET=change-me-to-a-random-string
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# URL de connexion Postgres (OBLIGATOIRE)
# Pour Supabase : Settings > Database > Connection string (URI)
# Exemple : postgresql://postgres.[ref]:[MOT_DE_PASSE]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/supdesrh?serverVersion=15&charset=utf8"
###< doctrine/doctrine-bundle ###

###> Supabase (pour vérifier les JWT) ###
# URL du projet Supabase (Settings > API > Project URL)
SUPABASE_PROJECT_URL=https://ton-projet.supabase.co
# JWT Audience (souvent "authenticated" ou vide)
SUPABASE_JWT_AUD=authenticated
###< Supabase ###

###> routing ###
DEFAULT_URI=http://127.0.0.1:8000
###< routing ###

###> mailer (optionnel) ###
MAILER_DSN=null://null
###< mailer ###

###> messenger (optionnel) ###
MESSENGER_TRANSPORT_DSN=doctrine://default
###< messenger ###
