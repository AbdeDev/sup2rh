# =============================================================================
# Sup2Rh Backend — Variables d'environnement
# Copie ce fichier en .env et remplis les valeurs
# =============================================================================

###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-to-a-random-string-32-chars
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Supabase Postgres : Settings > Database > Connection string (URI)
# Format: postgresql://postgres.[ref]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/supdesrh?serverVersion=15&charset=utf8"
###< doctrine/doctrine-bundle ###

###> supabase (JWT verification) ###
# Settings > API > Project URL
SUPABASE_PROJECT_URL=https://ton-projet.supabase.co
# JWT Audience (généralement "authenticated")
SUPABASE_JWT_AUD=authenticated
###< supabase ###

###> AI Providers (optionnel — au moins un recommandé) ###
# Groq (gratuit, rapide) : https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (fallback) : https://openrouter.ai/keys
OPENROUTER_API_KEY=
# HuggingFace (dernier recours) : https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
###< AI ###

###> CORS (prod uniquement — regex des origins autorisées) ###
# Exemple: ^https://(web\.ton-domaine\.pages\.dev|admin\.ton-domaine\.pages\.dev)$
CORS_ALLOW_ORIGIN='^https?://localhost(:[0-9]+)?$'
###< CORS ###

###> routing ###
DEFAULT_URI=http://127.0.0.1:8000
###< routing ###

###> mailer (optionnel) ###
MAILER_DSN=null://null
SUPPORT_EMAIL=supdesrh.com
###< mailer ###

###> messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default
###< messenger ###

###> docker/koyeb (optionnel) ###
# Port d'écoute (auto-fourni par Koyeb/Railway/Render)
# PORT=8000
# Lancer les migrations au démarrage du container
# RUN_MIGRATIONS=true
###< docker ###
