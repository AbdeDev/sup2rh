# =============================================================================
# Sup2Rh — Variables d'environnement PRODUCTION
# À placer sur le serveur VPS : /opt/sup2rh/.env.prod
# ⚠️  NE JAMAIS COMMITER CE FICHIER REMPLI
# =============================================================================

# ── Symfony ──
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=GENERE_UNE_CLE_SECRETE_32_CHARS_MIN

# ── Database (Supabase Postgres) ──
DATABASE_URL="postgresql://postgres.XXXXX:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# ── Supabase (JWT verification) ──
SUPABASE_PROJECT_URL=https://XXXXX.supabase.co
SUPABASE_JWT_AUD=authenticated

# ── AI Providers ──
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# ── CORS (regex des origins autorisées) ──
# Remplace par tes URLs Cloudflare Pages réelles
CORS_ALLOW_ORIGIN='^https://(ton-web\.pages\.dev|ton-admin\.pages\.dev|ton-landing\.pages\.dev)$'

# ── Routing ──
DEFAULT_URI=https://ton-backend.koyeb.app

# ── Migrations ──
RUN_MIGRATIONS=true

# ── Mailer ──
MAILER_DSN=null://null

# ── Messenger ──
MESSENGER_TRANSPORT_DSN=doctrine://default
