# =============================================================================
# .env.staging.example — Variables d'environnement STAGING
# Copier en .env.staging et remplir les vraies valeurs.
# ⚠️  Ne jamais committer .env.staging (il est dans .gitignore)
# =============================================================================

# ── Backend Symfony ────────────────────────────────────────────────────────────
# Base de données de staging (Supabase ou Postgres dédié)
DATABASE_URL=postgresql://postgres.XXXXXX:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?serverVersion=15&charset=utf8

SUPABASE_PROJECT_URL=https://XXXXXX.supabase.co
SUPABASE_JWT_AUD=authenticated

# CORS : autoriser les frontends locaux en staging
CORS_ALLOW_ORIGIN=http://localhost:8080,http://localhost:8001

APP_SECRET=change_me_in_staging_32chars_minimum

# ── Frontend (variables VITE / PUBLIC) ────────────────────────────────────────
VITE_SUPABASE_URL=https://XXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXX

# URLs publiques staging
PUBLIC_API_URL=http://localhost:8001
PUBLIC_WEB_URL=http://localhost:8080/web
